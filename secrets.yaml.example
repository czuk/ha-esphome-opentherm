# Copy this file to secrets.yaml (which is gitignored) and fill in real
# values. Generate each api key with: openssl rand -base64 32

wifi_ssid: "your-wifi-ssid"
wifi_password: "your-wifi-password"

# esphome-otgw (otgw.yaml) - master device driving the real boiler
otgw_api_key: "generate-with-openssl-rand-base64-32"
otgw_ap_fallback_password: "fallback-hotspot-password"

# esphome-nest-otgw (nest_otgw_listener.yaml) - Nest boiler emulator
nest_otgw_api_key: "generate-with-openssl-rand-base64-32"
nest_otgw_ap_fallback_password: "fallback-hotspot-password"
